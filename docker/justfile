# unqualified `latest`, plus the rolling `latest-cu129` and the versioned
# `<version>-cu129` tags. The tag suffix matches the VLLM base image.
release-primary:
    ARG_TAG_POSTFIX="-cu129" ARG_TAG_LATEST=1 ARG_BUILD_EXTRA_ARGS='--build-arg VLLM_IMAGE_TAG=v0.5.15.post1-cu129' just _release-raw
