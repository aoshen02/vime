diff --git a/vllm/distributed/device_communicators/all2all.py b/vllm/distributed/device_communicators/all2all.py
index d8790dbf42c..d68b4acd8df 100644
--- a/vllm/distributed/device_communicators/all2all.py
+++ b/vllm/distributed/device_communicators/all2all.py
@@ -424,6 +424,70 @@ class DeepEPLLAll2AllManager(DeepEPAll2AllManagerBase):
         DeepEPLLAll2AllManager._last_mask = None
 
 
+class DeepEPAutoAll2AllManager(DeepEPLLAll2AllManager):
+    def __init__(self, cpu_group, tcp_store_group=None):
+        super().__init__(cpu_group, tcp_store_group)
+        self._shared_handle = None
+        self._layouts = {}
+        self._has_prefill = False
+
+    def _make_all2all_kwargs(
+        self,
+        max_num_tokens_per_dp_rank: int,
+        token_hidden_size: int,
+        num_ep_ranks: int,
+        num_global_experts: int,
+        num_local_experts: int,
+    ) -> dict[Any, Any]:
+        import deep_ep
+
+        buffers = super()._make_all2all_kwargs(
+            max_num_tokens_per_dp_rank,
+            token_hidden_size,
+            num_ep_ranks,
+            num_global_experts,
+            num_local_experts,
+        )
+        hidden_bytes = token_hidden_size * 2
+        configs = (
+            deep_ep.Buffer.get_dispatch_config(self.world_size),
+            deep_ep.Buffer.get_combine_config(self.world_size),
+        )
+        buffers["num_nvl_bytes"] = max(
+            buffers["num_nvl_bytes"],
+            *(
+                config.get_nvl_buffer_size_hint(hidden_bytes, self.world_size)
+                for config in configs
+            ),
+        )
+        buffers["num_rdma_bytes"] = max(
+            buffers["num_rdma_bytes"],
+            *(
+                config.get_rdma_buffer_size_hint(hidden_bytes, self.world_size)
+                for config in configs
+            ),
+        )
+        buffers["num_qps_per_rank"] = max(self.num_sms, num_local_experts)
+        return buffers
+
+    def get_handle(self, kwargs):
+        if kwargs:
+            self._shared_handle = super().get_handle(kwargs)
+            self._layouts[self._shared_handle] = (
+                kwargs["max_num_tokens_per_dp_rank"],
+                kwargs["token_hidden_size"],
+                kwargs["num_global_experts"],
+            )
+        assert self._shared_handle is not None
+        return self._shared_handle
+
+    def prepare_step(self, has_prefill: bool):
+        if self._has_prefill and not has_prefill:
+            for handle, layout in self._layouts.items():
+                handle.clean_low_latency_buffer(*layout)
+        self._has_prefill = has_prefill
+
+
 @dataclass
 class _NixlEPBufferState:
     buffer: Any
