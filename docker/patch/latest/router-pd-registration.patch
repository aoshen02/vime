diff --git a/tests/pd_worker_registration_test.rs b/tests/pd_worker_registration_test.rs
new file mode 100644
index 0000000..1ae9f8e
--- /dev/null
+++ b/tests/pd_worker_registration_test.rs
@@ -0,0 +1,504 @@
+use axum::{
+    body::{to_bytes, Body},
+    extract::State,
+    http::{HeaderMap, Request, StatusCode},
+    routing::{get, post},
+    Json, Router,
+};
+use serde_json::{json, Value};
+use std::sync::{
+    atomic::{AtomicBool, AtomicUsize, Ordering},
+    Arc, Mutex,
+};
+use tokio::{net::TcpListener, sync::Notify, task::JoinHandle, time::Duration};
+use tower::ServiceExt;
+use vllm_router_rs::{
+    config::{KvConnector, RouterConfig, RoutingMode},
+    routers::http::vllm_pd_router::VllmPDRouter,
+    server::{build_app_with_request_tracing, AppContext, AppState},
+};
+
+#[derive(Clone)]
+struct BackendState {
+    bootstrap: Arc<Mutex<String>>,
+    queries: Arc<AtomicUsize>,
+    failures: Arc<AtomicUsize>,
+    requests: Arc<Mutex<Vec<(HeaderMap, Value)>>>,
+    health_paused: Arc<AtomicBool>,
+    health_started: Arc<Notify>,
+    health_release: Arc<Notify>,
+}
+
+struct Backend {
+    url: String,
+    port: u16,
+    state: BackendState,
+    task: JoinHandle<()>,
+}
+
+impl Backend {
+    async fn new() -> Self {
+        let state = BackendState {
+            bootstrap: Arc::new(Mutex::new(json!({"0": {"engine_id": "old"}}).to_string())),
+            queries: Arc::new(AtomicUsize::new(0)),
+            failures: Arc::new(AtomicUsize::new(0)),
+            requests: Arc::new(Mutex::new(Vec::new())),
+            health_paused: Arc::new(AtomicBool::new(false)),
+            health_started: Arc::new(Notify::new()),
+            health_release: Arc::new(Notify::new()),
+        };
+        let app = Router::new()
+            .route("/health", get(health))
+            .route("/query", get(bootstrap))
+            .route("/v1/completions", post(completion))
+            .with_state(state.clone());
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let task = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+        Self {
+            url: format!("http://127.0.0.1:{port}"),
+            port,
+            state,
+            task,
+        }
+    }
+
+    fn set_bootstrap(&self, body: Value) {
+        *self.state.bootstrap.lock().unwrap() = body.to_string();
+    }
+
+    fn last_request(&self) -> (HeaderMap, Value) {
+        self.state.requests.lock().unwrap().last().unwrap().clone()
+    }
+}
+
+impl Drop for Backend {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+async fn health(State(state): State<BackendState>) -> StatusCode {
+    if state.health_paused.load(Ordering::SeqCst) {
+        state.health_started.notify_one();
+        state.health_release.notified().await;
+    }
+    StatusCode::OK
+}
+
+async fn bootstrap(State(state): State<BackendState>) -> (StatusCode, String) {
+    state.queries.fetch_add(1, Ordering::SeqCst);
+    if state
+        .failures
+        .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |remaining| {
+            remaining.checked_sub(1)
+        })
+        .is_ok()
+    {
+        return (StatusCode::SERVICE_UNAVAILABLE, "not ready".to_owned());
+    }
+    let body = state.bootstrap.lock().unwrap().clone();
+    (StatusCode::OK, body)
+}
+
+async fn completion(
+    State(state): State<BackendState>,
+    headers: HeaderMap,
+    Json(body): Json<Value>,
+) -> Json<Value> {
+    state.requests.lock().unwrap().push((headers, body));
+    Json(json!({
+        "choices": [{"text": "ok", "index": 0, "finish_reason": "stop"}],
+        "kv_transfer_params": {"remote_engine_id": "nixl-response", "opaque": [1, 2]}
+    }))
+}
+
+async fn app(
+    connector: KvConnector,
+    dp_size: usize,
+    prefill: Option<&Backend>,
+    decode: Option<&Backend>,
+) -> (Router, Arc<AppContext>) {
+    let prefill_urls = prefill
+        .map(|worker| vec![(worker.url.clone(), Some(worker.port))])
+        .unwrap_or_default();
+    let decode_urls = decode
+        .map(|worker| vec![worker.url.clone()])
+        .unwrap_or_default();
+    let config = RouterConfig {
+        mode: RoutingMode::VllmPrefillDecode {
+            prefill_urls: prefill_urls.clone(),
+            decode_urls: decode_urls.clone(),
+            prefill_policy: None,
+            decode_policy: None,
+            discovery_address: None,
+        },
+        kv_connector: connector,
+        intra_node_data_parallel_size: dp_size,
+        worker_startup_timeout_secs: 1,
+        worker_startup_check_interval_secs: 1,
+        ..Default::default()
+    };
+    let context =
+        Arc::new(AppContext::new(config, reqwest::Client::new(), 64, None, vec![]).unwrap());
+    let router = Arc::new(
+        VllmPDRouter::new(prefill_urls, decode_urls, None, &context)
+            .await
+            .unwrap(),
+    );
+    let state = Arc::new(AppState {
+        router,
+        context: context.clone(),
+        concurrency_queue_tx: None,
+        router_manager: None,
+    });
+    (
+        build_app_with_request_tracing(state, 1024 * 1024, vec![], vec![], true, false),
+        context,
+    )
+}
+
+async fn request(app: &Router, method: &str, path: &str, body: Value) -> (StatusCode, Value) {
+    let response = tokio::time::timeout(
+        Duration::from_secs(10),
+        app.clone().oneshot(
+            Request::builder()
+                .method(method)
+                .uri(path)
+                .header("content-type", "application/json")
+                .body(Body::from(body.to_string()))
+                .unwrap(),
+        ),
+    )
+    .await
+    .expect("bounded HTTP request")
+    .unwrap();
+    let status = response.status();
+    let bytes = to_bytes(response.into_body(), 1024 * 1024).await.unwrap();
+    let body = serde_json::from_slice(&bytes)
+        .unwrap_or_else(|_| Value::String(String::from_utf8_lossy(&bytes).into_owned()));
+    (status, body)
+}
+
+async fn add(app: &Router, url: &str, kind: &str, port: Option<u16>) -> (StatusCode, Value) {
+    request(
+        app,
+        "POST",
+        "/workers",
+        json!({"url": url, "worker_type": kind, "bootstrap_port": port}),
+    )
+    .await
+}
+
+async fn delete(app: &Router, url: &str) {
+    let encoded: String = url::form_urlencoded::byte_serialize(url.as_bytes()).collect();
+    let response = request(app, "DELETE", &format!("/workers/{encoded}"), Value::Null).await;
+    assert_eq!(response.0, StatusCode::OK, "{response:?}");
+}
+
+async fn generate(app: &Router) {
+    let response = request(
+        app,
+        "POST",
+        "/v1/completions",
+        json!({"model": "test", "prompt": "hello", "max_tokens": 2, "stream": false}),
+    )
+    .await;
+    assert_eq!(response.0, StatusCode::OK, "{response:?}");
+    assert_eq!(response.1["choices"][0]["text"], "ok");
+}
+
+#[tokio::test]
+async fn nixl_delete_then_typed_readd_preserves_prefill_and_decode() {
+    let prefill = Backend::new().await;
+    let decode = Backend::new().await;
+    let (app, context) = app(KvConnector::Nixl, 1, Some(&prefill), Some(&decode)).await;
+    for (worker, kind) in [(&prefill, "prefill"), (&decode, "decode")] {
+        delete(&app, &worker.url).await;
+        assert!(context.worker_registry.get_by_url(&worker.url).is_none());
+        assert_eq!(context.worker_registry.get_all().len(), 1);
+        let response = add(&app, &worker.url, kind, Some(9123)).await;
+        assert_eq!(response.0, StatusCode::OK, "{response:?}");
+        let (_, listing) = request(&app, "GET", "/workers", Value::Null).await;
+        assert_eq!(listing["stats"]["prefill_count"], 1);
+        assert_eq!(listing["stats"]["decode_count"], 1);
+        assert_eq!(listing["stats"]["regular_count"], 0);
+        let registered = listing["workers"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|entry| entry["url"] == worker.url)
+            .unwrap();
+        assert_eq!(registered["worker_type"], kind);
+        if kind == "prefill" {
+            assert_eq!(registered["bootstrap_port"], 9123);
+        }
+        generate(&app).await;
+        assert_eq!(
+            decode.last_request().1["kv_transfer_params"],
+            json!({"remote_engine_id": "nixl-response", "opaque": [1, 2]})
+        );
+    }
+    assert_eq!(prefill.state.queries.load(Ordering::SeqCst), 0);
+    assert_eq!(decode.state.queries.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn pd_create_requires_worker_type() {
+    let worker = Backend::new().await;
+    let (app, context) = app(KvConnector::Nixl, 1, None, None).await;
+    for body in [
+        json!({"url": worker.url}),
+        json!({"url": worker.url, "worker_type": "regular"}),
+    ] {
+        let (status, error) = request(&app, "POST", "/workers", body).await;
+        assert_eq!(status, StatusCode::BAD_REQUEST);
+        assert_eq!(error["code"], "ADD_WORKER_FAILED");
+        assert!(error["error"].as_str().unwrap().contains("worker_type"));
+        assert!(context.worker_registry.get_all().is_empty());
+    }
+}
+
+#[tokio::test]
+async fn mooncake_readd_refreshes_startup_engine_and_bootstrap_address() {
+    let prefill = Backend::new().await;
+    let decode = Backend::new().await;
+    let replacement_bootstrap = Backend::new().await;
+    replacement_bootstrap.set_bootstrap(json!({"0": {"engine_id": "replacement"}}));
+    let (app, context) = app(KvConnector::Mooncake, 1, Some(&prefill), Some(&decode)).await;
+    generate(&app).await;
+    assert_eq!(
+        decode.last_request().1["kv_transfer_params"]["remote_engine_id"],
+        "old"
+    );
+    delete(&app, &prefill.url).await;
+    assert!(context.worker_registry.get_by_url(&prefill.url).is_none());
+    let response = add(
+        &app,
+        &prefill.url,
+        "prefill",
+        Some(replacement_bootstrap.port),
+    )
+    .await;
+    assert_eq!(response.0, StatusCode::OK, "{response:?}");
+    generate(&app).await;
+    let params = decode.last_request().1["kv_transfer_params"].clone();
+    assert_eq!(params["remote_engine_id"], "replacement");
+    assert_eq!(params["remote_bootstrap_addr"], replacement_bootstrap.url);
+    assert_eq!(params["do_remote_prefill"], true);
+    assert_eq!(
+        params["transfer_id"],
+        prefill.last_request().1["kv_transfer_params"]["transfer_id"]
+    );
+    assert_eq!(prefill.state.queries.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        replacement_bootstrap.state.queries.load(Ordering::SeqCst),
+        1
+    );
+}
+
+#[tokio::test]
+async fn mooncake_failed_bootstrap_does_not_register_and_can_retry() {
+    let prefill = Backend::new().await;
+    let decode = Backend::new().await;
+    let (app, context) = app(KvConnector::Mooncake, 1, Some(&prefill), Some(&decode)).await;
+    delete(&app, &prefill.url).await;
+    let counts = context.policy_registry.get_worker_counts();
+    for invalid in [
+        "not-json",
+        "{\"0\":{}}",
+        "{\"invalid-rank\":{\"engine_id\":\"new\"}}",
+        "{}",
+        "null",
+        "[]",
+    ] {
+        *prefill.state.bootstrap.lock().unwrap() = invalid.to_owned();
+        let response = add(&app, &prefill.url, "prefill", Some(prefill.port)).await;
+        assert_eq!(response.0, StatusCode::BAD_REQUEST, "{response:?}");
+        assert_eq!(response.1["code"], "ADD_WORKER_FAILED");
+        assert!(context.worker_registry.get_by_url(&prefill.url).is_none());
+        assert_eq!(context.worker_registry.get_all().len(), 1);
+        assert_eq!(context.policy_registry.get_worker_counts(), counts);
+    }
+    prefill.set_bootstrap(json!({"0": {"engine_id": "recovered"}}));
+    assert_eq!(
+        add(&app, &prefill.url, "prefill", Some(prefill.port))
+            .await
+            .0,
+        StatusCode::OK
+    );
+    generate(&app).await;
+    assert_eq!(
+        decode.last_request().1["kv_transfer_params"]["remote_engine_id"],
+        "recovered"
+    );
+}
