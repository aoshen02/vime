+async fn mooncake_dp_rank_delete_readd_uses_base_bootstrap_and_rank_engine() {
+    let prefill = Backend::new().await;
+    let decode = Backend::new().await;
+    prefill.set_bootstrap(json!({"0": {"engine_id": "rank-0"}, "1": {"engine_id": "rank-1"}}));
+    let (app, context) = app(KvConnector::Mooncake, 2, None, None).await;
+    for (worker, kind) in [(&prefill, "prefill"), (&decode, "decode")] {
+        assert_eq!(
+            add(&app, &worker.url, kind, Some(prefill.port)).await.0,
+            StatusCode::OK
+        );
+        for rank in 0..2 {
+            let ranked_url = format!("{}@{rank}", worker.url);
+            assert!(context.worker_registry.get_by_url(&ranked_url).is_some());
+            delete(&app, &ranked_url).await;
+            assert!(context.worker_registry.get_by_url(&ranked_url).is_none());
+        }
+        let ranked_url = format!("{}@1", worker.url);
+        assert_eq!(
+            add(&app, &ranked_url, kind, Some(prefill.port)).await.0,
+            StatusCode::OK
+        );
+        assert!(context
+            .worker_registry
+            .get_by_url(&format!("{}@0", worker.url))
+            .is_none());
+        assert!(context.worker_registry.get_by_url(&ranked_url).is_some());
+    }
+    generate(&app).await;
+    assert_eq!(prefill.last_request().0["x-data-parallel-rank"], "1");
+    assert_eq!(decode.last_request().0["x-data-parallel-rank"], "1");
+    assert_eq!(
+        decode.last_request().1["kv_transfer_params"]["remote_engine_id"],
+        "rank-1"
+    );
+    assert_eq!(
+        decode.last_request().1["kv_transfer_params"]["remote_bootstrap_addr"],
+        prefill.url
+    );
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn mooncake_pending_prefill_health_does_not_block_live_generation() {
+    let prefill = Backend::new().await;
+    let decode = Backend::new().await;
+    let new_prefill = Backend::new().await;
+    new_prefill.set_bootstrap(json!({"0": {"engine_id": "new-prefill"}}));
+    new_prefill
+        .state
+        .health_paused
+        .store(true, Ordering::SeqCst);
+    let (app, context) = app(KvConnector::Mooncake, 1, Some(&prefill), Some(&decode)).await;
+    generate(&app).await;
+
+    let request_app = app.clone();
+    let url = new_prefill.url.clone();
+    let port = new_prefill.port;
+    let pending = tokio::spawn(async move { add(&request_app, &url, "prefill", Some(port)).await });
+    tokio::time::timeout(
+        Duration::from_secs(5),
+        new_prefill.state.health_started.notified(),
+    )
+    .await
+    .expect("registration must reach the gated health request");
+    assert!(context
+        .worker_registry
+        .get_by_url(&new_prefill.url)
+        .is_none());
+    assert!(!pending.is_finished());
+
+    let serving = tokio::time::timeout(Duration::from_millis(500), generate(&app)).await;
+    let admission_pending = !pending.is_finished();
+    new_prefill
+        .state
+        .health_paused
+        .store(false, Ordering::SeqCst);
+    new_prefill.state.health_release.notify_one();
+    let admission = pending.await.unwrap();
+    assert_eq!(admission.0, StatusCode::OK, "{admission:?}");
+    assert!(
+        serving.is_ok(),
+        "existing Mooncake generation blocked behind unrelated prefill health"
+    );
+    assert!(admission_pending);
+    assert_eq!(
+        decode.last_request().1["kv_transfer_params"]["remote_engine_id"],
+        "old"
+    );
+    assert!(context
+        .worker_registry
+        .get_by_url(&new_prefill.url)
+        .is_some());
+
+    delete(&app, &prefill.url).await;
+    generate(&app).await;
+    assert_eq!(
+        decode.last_request().1["kv_transfer_params"]["remote_engine_id"],
+        "new-prefill"
+    );
+}
