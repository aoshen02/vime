+        if worker:
+            assert views["state"].shape[0] == expected_count
+            backing = expected_count * state_spec.page_size_bytes
+            assert {tensor.size for tensor in plan.kv_cache_tensors} == {backing}
+            assert backing + 12 * (expected_count + 3) <= budget
+        else:
