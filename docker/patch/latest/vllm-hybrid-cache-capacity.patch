+        assert set(worker.region_group_ids.values()) == {owned_group}
+        for region in worker.gpu_kv_caches.values():
+            region.fill_(17)
+        for region in worker.cpu_kv_caches.values():
+            region[1].fill_(33)
+        worker.bind_connector_metadata(
